# Prisma -> Supabase Postgres
DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres"

# Supabase Auth (JWKS) / Storage
SUPABASE_URL="https://<project-id>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
SUPABASE_STORAGE_BUCKET="post-images"

# Server
PORT=3000
FRONTEND_ORIGIN="http://localhost:5173"

# Cooldowns / limits (SPEC_1.md 4.5, all values provisional)
POST_COOLDOWN_SECONDS=30
CHAT_COOLDOWN_SECONDS=3
CHAT_POLL_INTERVAL_SECONDS=3
POST_MAX_LENGTH=280
CHAT_MAX_LENGTH=500
IMAGE_MAX_COUNT=4
IMAGE_MAX_SIZE_MB=5
